<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="salesrule" resource="default" engine="innodb">
        <column xsi:type="smallint" name="magenable_coupon_validity_days" unsigned="true" nullable="true" comment="Rolling Coupon Validity Days"/>
    </table>
    <table name="quote" resource="checkout" engine="innodb">
        <column xsi:type="smallint" name="magenable_coupon_expiry_review_required" unsigned="true" nullable="false" default="0" comment="Coupon Expiry Review Required"/>
        <column xsi:type="varchar" name="magenable_expired_coupon_code" nullable="true" length="255" comment="Expired Coupon Code"/>
        <column xsi:type="int" name="magenable_expired_coupon_rule_id" unsigned="true" nullable="true" comment="Expired Coupon Rule ID"/>
    </table>
    <table name="magenable_coupon_expiry" resource="default" engine="innodb" comment="Magenable Managed Coupon Expiry">
        <column xsi:type="int" name="coupon_id" unsigned="true" nullable="false" comment="Coupon ID"/>
        <column xsi:type="datetime" name="issued_at" nullable="false" comment="Issued At UTC"/>
        <column xsi:type="smallint" name="validity_days_at_issue" unsigned="true" nullable="false" comment="Validity Days Snapshot"/>
        <column xsi:type="datetime" name="rolling_expires_at" nullable="false" comment="Rolling Expiry UTC"/>
        <column xsi:type="varchar" name="issuance_source" nullable="false" length="16" comment="Issuance Source"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="coupon_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="MAGENABLE_COUPON_EXPIRY_COUPON_ID_SALESRULE_COUPON_ID" table="magenable_coupon_expiry" column="coupon_id" referenceTable="salesrule_coupon" referenceColumn="coupon_id" onDelete="CASCADE"/>
        <index referenceId="MAGENABLE_COUPON_EXPIRY_EXPIRES_AT" indexType="btree"><column name="rolling_expires_at"/></index>
    </table>
    <table name="magenable_coupon_expiry_request" resource="default" engine="innodb" comment="Magenable Coupon Issuance Idempotency Ledger">
        <column xsi:type="int" name="request_entity_id" unsigned="true" nullable="false" identity="true" comment="Request Entity ID"/>
        <column xsi:type="smallint" name="principal_type" unsigned="true" nullable="false" comment="Authenticated Principal Type"/>
        <column xsi:type="int" name="principal_id" unsigned="true" nullable="false" comment="Authenticated Principal ID"/>
        <column xsi:type="varchar" name="request_id" nullable="false" length="128" comment="Client Request ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" comment="Rule ID"/>
        <column xsi:type="varchar" name="payload_hash" nullable="false" length="64" comment="Canonical SHA-256 Payload Hash"/>
        <column xsi:type="int" name="coupon_id" unsigned="true" nullable="true" comment="Issued Coupon ID Or Tombstone ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At UTC"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="request_entity_id"/></constraint>
        <constraint xsi:type="unique" referenceId="MAGENABLE_COUPON_EXPIRY_REQUEST_PRINCIPAL_REQUEST"><column name="principal_type"/><column name="principal_id"/><column name="request_id"/></constraint>
        <index referenceId="MAGENABLE_COUPON_EXPIRY_REQUEST_COUPON_ID" indexType="btree"><column name="coupon_id"/></index>
    </table>
</schema>
